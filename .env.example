# =============================================================================
# Heartland JA — environment
#
# Copy to .env.local and fill in. THE APPLICATION RUNS WITH NONE OF THESE SET:
# with no Supabase credentials it serves development seed data, so the site can
# be built, demonstrated and reviewed before any backend exists.
#
# Never commit .env.local. The service role key in particular bypasses every
# Row Level Security policy in the database.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# The public origin, used for canonical URLs, OpenGraph tags, JSON-LD and the
# sitemap.
#
# OPTIONAL ON VERCEL. If left blank the site falls back to
# VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then localhost — so preview
# deployments get their own correct URLs and production picks up the custom
# domain automatically once it is attached.
#
# Set it explicitly to override that detection. A scheme is added if missing and
# a trailing slash is stripped.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------------
# Leave blank to run on seed data. Fill in to connect a real project.
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. BYPASSES ROW LEVEL SECURITY — never expose to the browser
# and never prefix with NEXT_PUBLIC_. Required for anonymous listing-event
# tracking; without it, tracking is inert but the site works.
SUPABASE_SERVICE_ROLE_KEY=

# --- Authentication -----------------------------------------------------------
# stub     — dev-only role switcher at /dev/login (default when Supabase is unset)
# supabase — real Supabase Auth
NEXT_PUBLIC_AUTH_MODE=stub

# Optional: sign in as this role automatically in development.
# One of: admin | editor | contributor | business_owner
DEV_ROLE=

# --- Analytics ----------------------------------------------------------------
# Salt for hashing session ids and user agents before they are stored. Rotating
# it resets deduplication windows.
#
# SET THIS IN PRODUCTION. Left blank, the app falls back to a shared development
# salt and logs a warning — deduplication still works, but the hashes are not
# unique to this deployment.
# Generate with:  openssl rand -hex 32
ANALYTICS_SALT=

# =============================================================================
# Phase 5 and later — not used yet
# =============================================================================

# Transactional and newsletter email (Resend).
# RESEND_API_KEY=

# AzuraCast live stream, self-hosted on a separate VPS.
# NEXT_PUBLIC_STREAM_URL=
